# Radulf environment variables — copy to .env.local and fill in as needed.
# Every variable is OPTIONAL. With none set, Radulf runs in localhost-only,
# no-auth development mode. (.env* is gitignored; never commit real secrets.)

# --- Authentication (set these to expose Radulf beyond localhost) ---

# bcrypt hash of your login password. SET -> auth is enabled and the server
# binds 0.0.0.0. UNSET -> auth is disabled and the server binds 127.0.0.1.
# Generate with:
#   node -e 'console.log(require("bcryptjs").hashSync(process.argv[1], 12))' -- '<password>'
RADULF_AUTH_PASSWORD_HASH=

# Public hostname Radulf is served from, used for the CSRF Origin check on
# mutating requests (e.g. radulf.example.com). Localhost origins are always
# allowed. Set this when deploying behind a public hostname / reverse proxy.
RADULF_ALLOWED_ORIGIN=

# Header your trusted reverse proxy sets with the real client IP, used by the
# login rate limiter (e.g. x-forwarded-for). Leave unset for direct/localhost.
RADULF_TRUSTED_PROXY_IP_HEADER=

# The HMAC session secret is generated automatically on first boot and stored
# in data/auth-secret. Do NOT set this by hand; rotating the file (delete +
# restart) is the kill switch that invalidates all sessions.
# RADULF_AUTH_SECRET=

# --- Runtime data ---

# Directory for runtime state (SQLite DB, transcripts). Defaults to ./data.
RADULF_DATA_DIR=

# Root for agent worktrees. Defaults to ./worktrees BESIDE the data dir (never
# inside it) — the run sandbox denies data/ wholesale, so worktrees must not
# live under it. Old runs recorded absolute paths and keep resolving.
RADULF_WORKTREES_DIR=

# Root for per-run planner output (plans/<run-id>/ is the planner's only
# writable path). Defaults to ./plans beside the data dir.
RADULF_PLANS_DIR=

# --- OpenRouter provider (optional; can also be set in the Settings UI) ---

# API key for the OpenRouter provider. Only needed if an agent role uses it.
OPENROUTER_API_KEY=

# Override the OpenRouter base URL (defaults to OpenRouter's public endpoint).
OPENROUTER_BASE_URL=
