# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# radulf runtime data. worktrees/, plans/ and runtmp/ are siblings of data/ by
# design (spec 14: the sandbox denies data/ with no carve-out), so each needs its
# own entry — with the defaults they are created in the repo root.
/data
/worktrees
/plans
/runtmp

# benchmark reports (local evidence, not source)
/benchmarks/reports/
.DS_Store
