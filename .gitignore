# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# radulf runtime data. worktrees/, plans/ and runtmp/ are siblings of data/ by
# design (spec 14: the sandbox denies data/ with no carve-out), so each needs its
# own entry — with the defaults they are created in the repo root.
/data
/worktrees
/plans
/runtmp

.DS_Store

# local investigation/planning notes — not user-facing docs
/PLAN.md

# Impeccable design tooling. Shared config and the DESIGN.md sidecar are tracked;
# per-developer and per-session state is not.
.impeccable/config.local.json
.impeccable/live/sessions/
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
.impeccable/mocks/
.impeccable/review/
.impeccable/critique/
.impeccable/build/

# Per-host compose tweaks (DNS, ports, user); docs/DOCKER.md explains when.
/compose.override.yaml
