  },
  "keywords": [
    "agent-loop",
    "autonomous-agents",
    "self-improving",
    "ai-agents",
    "coding-agent",
    "ralph-loop",
    "local-first",
    "nextjs",
    "git-worktree"
  ],
  "engines": {
    "node": ">=22"
