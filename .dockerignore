# Trims the build context. The runtime stage copies from the build stage,
# never from the context, so nothing here affects what ships in the image.
.git
node_modules
.next
dist
coverage
*.tsbuildinfo

# Runtime state and secrets: never part of an image.
data
worktrees
plans
runtmp
repos
.env*

# Agent, design-tool, and CI scaffolding the build does not read.
.agents
.claude
.impeccable
.github
PLAN.md

# The desktop shell (make desktop) runs beside a server, never inside one, and
# its node_modules is Electron: hundreds of MB the build would only copy.
desktop

Dockerfile
compose.yaml
.dockerignore
